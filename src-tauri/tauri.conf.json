{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VeloxGrab",
  "version": "1.2.3",
  "identifier": "com.veloxgrab.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": null,
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VeloxGrab",
        "width": 1040,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "bin/yt-dlp.exe": "bin/yt-dlp.exe",
      "../extension/*": "extension/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
